# CodeBridge Platform Environment Variables
NODE_ENV=development
PORT=3000

# Authentication & Session Security (Replace with a high-entropy 64+ char secret in production)
JWT_SECRET=your_jwt_secret_min_32_characters_long
JWT_EXPIRES_IN=7d

# Supabase PostgreSQL Database Configuration
# Supavisor Connection Pooler (Transaction Mode on port 6543 - recommended for Vercel serverless):
DATABASE_URL=postgresql://postgres.zmlaqqgjlqpzigrnxdsx:[YOUR_PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct Connection (Session Mode on port 5432 - used for migrations and setup-supabase):
DIRECT_URL=postgresql://postgres.zmlaqqgjlqpzigrnxdsx:[YOUR_PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres

# Multi-country Default Base Currency (NGN or KES)
DEFAULT_CURRENCY=NGN

# Production Initial Super Admin Provisioning (Used during db:setup; never commit real passwords)
ADMIN_INITIAL_EMAIL=admin@codebridge.com
ADMIN_INITIAL_PASSWORD=your_secure_initial_admin_password_min_12_chars

