# CodeBridge Platform Environment Variables
NODE_ENV=development
PORT=3000

# Authentication & Session Security (Replace with a high-entropy 64+ char secret in production)
JWT_SECRET=your_jwt_secret_min_32_characters_long
JWT_EXPIRES_IN=7d

# Supabase PostgreSQL Database Configuration
# Supavisor Connection Pooler (Transaction Mode on port 6543 - recommended for Vercel serverless):
DATABASE_URL=postgresql://postgres.zmlaqqgjlqpzigrnxdsx:[YOUR_PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct Connection (Session Mode on port 5432 - used for migrations and setup-supabase):
DIRECT_URL=postgresql://postgres.zmlaqqgjlqpzigrnxdsx:[YOUR_PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres

# Multi-country Default Base Currency (NGN or KES)
DEFAULT_CURRENCY=NGN

# Production Initial Super Admin Provisioning (Used during db:setup; never commit real passwords)
ADMIN_INITIAL_EMAIL=admin@codebridge.com
ADMIN_INITIAL_PASSWORD=your_secure_initial_admin_password_min_12_chars

# Google OAuth 2.0 Credentials (Required for Sales Representative authentication)
# Create at https://console.cloud.google.com/apis/credentials (OAuth 2.0 Client ID for Web Applications)
# Authorized redirect URI: https://your-domain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# GOOGLE_REDIRECT_URI=https://code-bridge-rosy.vercel.app/api/auth/callback/google

# Flutterwave Payment Gateway (KES Collection via M-Pesa/Card + NGN/Merchant Settlement)
# Sandbox keys begin with FLWPUBK_TEST- / FLWSECK_TEST-
# Live keys begin with FLWPUBK- / FLWSECK-
# NEVER expose FLW_SECRET_KEY or FLW_WEBHOOK_SECRET_HASH to client-side code!
FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxx-X
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxx-X
FLW_WEBHOOK_SECRET_HASH=your_verif_hash_secret_string
NEXT_PUBLIC_FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxx-X
